									"  pm.collectionVariables.set(\"captainRefreshToken\", json.refreshToken);",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "Login Captain",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"url": {
							"raw": "{{baseUrl}}/captain/login",
							"host": ["{{baseUrl}}"],
							"path": ["captain", "login"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"captain@example.com\",\n  \"password\": \"password123\"\n}"
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const json = pm.response.json();",
									"if (json.accessToken) {",
									"  pm.collectionVariables.set(\"captainAccessToken\", json.accessToken);",
									"}",
									"if (json.refreshToken) {",
									"  pm.collectionVariables.set(\"captainRefreshToken\", json.refreshToken);",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "Refresh Captain Token",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"url": {
							"raw": "{{baseUrl}}/captain/refresh",
							"host": ["{{baseUrl}}"],
							"path": ["captain", "refresh"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{captainRefreshToken}}\"\n}"
						}
					}
				},
				{
					"name": "Get Captain Profile",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Authorization", "value": "Bearer {{captainAccessToken}}"}
						],
						"url": {
							"raw": "{{baseUrl}}/captain/profile",
							"host": ["{{baseUrl}}"],
							"path": ["captain", "profile"]
						}
					}
				},
				{
					"name": "Logout Captain",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Authorization", "value": "Bearer {{captainAccessToken}}"}
						],
						"url": {
							"raw": "{{baseUrl}}/captain/logout",
							"host": ["{{baseUrl}}"],
							"path": ["captain", "logout"]
						}
					}
				}
			]
		},
		{
			"name": "Ride",
			"item": [
				{
					"name": "Create Ride",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{userAccessToken}}"}
						],
						"url": {
							"raw": "{{baseUrl}}/ride/create",
							"host": ["{{baseUrl}}"],
							"path": ["ride", "create"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"pickup\": \"MG Road\",\n  \"destination\": \"Airport\",\n  \"vehicleType\": \"car\"\n}"
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const json = pm.response.json();",
									"if (json && json.id) {",
									"  pm.collectionVariables.set(\"rideId\", json.id);",
									"} else if (json && json.ride && json.ride.id) {",
									"  pm.collectionVariables.set(\"rideId\", json.ride.id);",
									"}",
									"if (json && json.otp) {",
									"  pm.collectionVariables.set(\"rideOtp\", json.otp);",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "Confirm Ride",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{captainAccessToken}}"}
						],
						"url": {
							"raw": "{{baseUrl}}/ride/confirm",
							"host": ["{{baseUrl}}"],
							"path": ["ride", "confirm"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"rideId\": \"{{rideId}}\"\n}"
						}
					}
				},
				{
					"name": "Start Ride",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Authorization", "value": "Bearer {{captainAccessToken}}"}
						],
						"url": {
							"raw": "{{baseUrl}}/ride/start?rideId={{rideId}}&otp={{rideOtp}}",
							"host": ["{{baseUrl}}"],
							"path": ["ride", "start"],
							"query": [
								{"key": "rideId", "value": "{{rideId}}"},
								{"key": "otp", "value": "{{rideOtp}}"}
							]
						}
					}
				},
				{
					"name": "End Ride",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{captainAccessToken}}"}
						],
						"url": {
							"raw": "{{baseUrl}}/ride/end",
							"host": ["{{baseUrl}}"],
							"path": ["ride", "end"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"rideId\": \"{{rideId}}\"\n}"
						}
					}
				}
			]
		}
	],
	"variable": [
		{"key": "baseUrl", "value": "http://localhost:8080/api"},
		{"key": "userAccessToken", "value": ""},
		{"key": "userRefreshToken", "value": ""},
		{"key": "captainAccessToken", "value": ""},
		{"key": "captainRefreshToken", "value": ""},
		{"key": "rideId", "value": ""},
		{"key": "rideOtp", "value": ""}
	]
}
